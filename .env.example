# Local Docker Postgres
DATABASE_URL="postgresql://racepulse:racepulse@localhost:5433/racepulse?schema=public"
DIRECT_URL="postgresql://racepulse:racepulse@localhost:5433/racepulse?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin
ADMIN_EMAIL="admin@racepulse.local"
ADMIN_PASSWORD="troque-essa-senha"
JWT_SECRET="gere-com-node-crypto-randombytes-64-hex"

# Tavily + Gemini
TAVILY_API_KEY=""
TAVILY_SEARCH_DEPTH="advanced"
TAVILY_MAX_RESULTS="8"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Redis local ou Upstash
REDIS_PROVIDER="local"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Import real. Não há fallback fake na V4.
IMPORT_CACHE_TTL_SECONDS="86400"
IMPORT_QUERY="2026 endurance racing GT3 calendar Nürburgring 24 Spa 24 GT World Challenge Europe WEC IMSA Intercontinental GT Challenge dates"
INTERNAL_IMPORT_SECRET="gere-com-node-crypto-randombytes-32-hex"
