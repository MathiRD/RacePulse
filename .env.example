# Local Docker Postgres
DATABASE_URL="postgresql://racepulse:racepulse@localhost:5433/racepulse?schema=public"
DIRECT_URL="postgresql://racepulse:racepulse@localhost:5433/racepulse?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Admin
ADMIN_EMAIL="admin@racepulse.local"
ADMIN_PASSWORD="troque-essa-senha"
JWT_SECRET="gere-com-node-crypto-randombytes-64-hex"

# Busca principal: Gemini Grounded Search
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_SEARCH_MODEL="gemini-2.5-flash"
GEMINI_NORMALIZER_MODEL="gemini-2.5-flash"
GEMINI_RETRY_ATTEMPTS="4"

# Tavily fica opcional, só para fallback quando IMPORT_SEARCH_PROVIDER=hybrid ou tavily
TAVILY_API_KEY=""
TAVILY_SEARCH_DEPTH="advanced"
TAVILY_MAX_RESULTS="20"

# Provider de importação: gemini | hybrid | tavily
IMPORT_SEARCH_PROVIDER="gemini"
IMPORT_MAX_TASKS="7"
IMPORT_EVIDENCE_MAX_CHARS="90000"
IMPORT_JSON_REPAIR_MAX_CHARS="70000"
IMPORT_CACHE_TTL_SECONDS="86400"
# Se quiser buscar o calendário desde 01/01/2026, defina IMPORT_MIN_DATE="2026-01-01".
# Sem essa variável, o import usa a data atual para não importar corridas já passadas.
IMPORT_MIN_DATE=""
IMPORT_YEAR="2026"
IMPORT_QUERY="2026+ real GT3 and endurance calendar and official entry lists drivers teams cars, exclude tests prologue trials esports unless marked as esport"
INTERNAL_IMPORT_SECRET="gere-com-node-crypto-randombytes-32-hex"

# Redis local ou Upstash
REDIS_PROVIDER="local"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Compact import mode: 1 Gemini request per import instead of search + normalize per task.
IMPORT_COMPACT_MODE="true"
IMPORT_AUTO_EXPAND_TASKS="false"
IMPORT_ENABLE_JSON_REPAIR="false"
IMPORT_MAX_TASKS="1"
GEMINI_RETRY_ATTEMPTS="1"
